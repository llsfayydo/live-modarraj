# Live Modarraj - إعدادات البيئة

# 🔐 بيانات قاعدة البيانات MongoDB
# استبدل هذا برابط قاعدة البيانات الفعلي الخاص بك
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/?appName=appname

# 🔑 مفتاح API TheSportsDB المدفوع (مفتاحك الفعلي)
THESPORTSDB_API_KEY=5010468507

# 🚀 منفذ التطبيق
PORT=5000

# 🌍 بيئة التطبيق
NODE_ENV=development

# 💾 إعدادات Caching (بالميلي ثانية)
CACHE_TTL=60000

# 📡 إعدادات Socket.io
SOCKET_IO_ALLOWED_ORIGINS=*

# 📊 الدوريات الافتراضية (فاصل بينها بفواصل)
DEFAULT_LEAGUES=English Premier League,La Liga,Serie A,Ligue 1,Bundesliga,Saudi Professional League,Egyptian Premier League,UEFA Champions League
