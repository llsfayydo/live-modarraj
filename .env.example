# Live Modarraj - إعدادات البيئة

# 🔐 بيانات قاعدة البيانات MongoDB
# استبدل هذا برابط قاعدة البيانات الفعلي الخاص بك
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/?appName=appname

# 🔑 مفتاح API TheSportsDB
# احصل على مفتاح مجاني من https://www.thesportsdb.com/api.php
THESPORTSDB_API_KEY=5010468507

# 🚀 منفذ التطبيق
PORT=5000

# 🌍 بيئة التطبيق
NODE_ENV=development

# 💾 إعدادات Caching
CACHE_TTL=60000

# 📡 إعدادات Socket.io
SOCKET_IO_ALLOWED_ORIGINS=*
